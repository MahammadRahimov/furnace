# Furnace settings file, for a setup without questions (for example automation):
#     sudo furnace setup --config config.env
# Normally you do not need it: "sudo furnace setup" asks the same questions.
# Empty values are found automatically or get the default shown in the comment.
# All values below are FAKE examples from the documentation ranges.
# Never commit your real config.env.
#
# The SAME file works on both servers. Each server finds its role from its own IP:
# the server that has LEADER_IP is the leader (keepalived priority 150), the one
# that has FOLLOWER_IP is the follower (the standby, priority 100).
# The follower takes the other settings from the leader's bundle
# (furnace-peer-bundle.tar.gz). Settings you add must match the leader.
# (Before 0.10.0 the IPs were THIS_IP and PEER_IP with ROLE. These still work.)

# The leader server's own IP address.
LEADER_IP=192.0.2.11

# The follower server's own IP address.
FOLLOWER_IP=192.0.2.12

# Only needed when one server has both IPs: leader or follower.
#ROLE=leader

# The shared IP (VIP, virtual IP). Everything that uses Furnace connects to this address.
SHARED_IP=192.0.2.10

# Network prefix length of the shared IP, for example 24 for a 255.255.255.0 mask.
SHARED_IP_PREFIX=24

# The network card that carries this server's IP and the shared IP. See: ip -br addr
# Empty = the card that has this server's IP.
INTERFACE=eth0

# Who may call the API. "any" (default) = every address; every call still needs an API token.
# Or limit it to IPs and ranges, separated by commas (for example a SOAR server and its engines).
# (Before 0.3.1 this setting was called XSOAR_IP. The old name still works.)
API_ALLOW_FROM=any

# Who may download the lists (EDLs, threat feeds). "any" (default) = every address;
# every download still needs the list login (user and password).
# Or limit it: use the address the firewall really connects from (often the management IP).
# For a firewall HA pair, list both, separated by commas. Example: 198.51.100.1,198.51.100.2
# (Before 0.3.1 this setting was called FIREWALL_IP. The old name still works.)
LISTS_ALLOW_FROM=any

# Days an IP stays in the active blocklist before the nightly job archives it.
ARCHIVE_AFTER_DAYS=90

# keepalived VRRP (Virtual Router Redundancy Protocol) password.
# Must be the same on both servers. 6 to 8 characters (keepalived uses only 8).
# Empty = setup creates a random one on the leader. The follower gets it from the bundle.
KEEPALIVED_PASSWORD=

# VRRP router ID, 1-255. Must be the same on both servers and unique on this network.
VRRP_ROUTER_ID=51

# Maximum number of entries in each EDL. Your firewall limit is 50,000. 0 = no limit.
MAX_IPS=50000
MAX_DOMAINS=50000

# Who may log in with SSH (people, for example admins). "any" or a comma-separated list of IPs/ranges.
SSH_ALLOW_FROM=any

# The leader copies the data to the follower over HTTPS. yes = also use SSH as a backup when HTTPS does not
# work (adds the user furnace-sync and SSH between the two servers). Default: no. The follower takes the
# leader's value.
#REPLICATION_SSH_FALLBACK=no

# Host firewall. ufw = configure ufw (default). none = do not touch the host firewall.
HOST_FIREWALL=ufw

# Follower only: the one-time join code from the leader (sudo furnace join-code there). The follower fetches
# the certificate and the secrets with it, instead of a copied bundle file. Used once, never saved.
#JOIN_CODE=

# The first API token. Used only on a leader that has no API token yet (not saved in setup.conf).
# TOKEN_ALLOW: comma-separated blocklist:read, blocklist:write, whitelist:read, whitelist:write, or all.
# Write includes read. TOKEN_EXPIRES_DAYS: 0 to 3650, 0 = never.
TOKEN_NAME=api
TOKEN_ALLOW=all
TOKEN_EXPIRES_DAYS=0
