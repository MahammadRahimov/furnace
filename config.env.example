# Furnace install settings.
# Copy this file to config.env, fill it in, then run: sudo ./install.sh
# All values below are FAKE examples from the documentation ranges.
# Never commit your real config.env.

# leader = the preferred leader (keepalived priority 150).
# follower = the standby server (priority 100).
ROLE=leader

# This server's own IP address.
THIS_IP=192.0.2.11

# The other Furnace server's IP address.
PEER_IP=192.0.2.12

# The shared IP (VIP, virtual IP). The firewall and XSOAR always use this address.
SHARED_IP=192.0.2.10

# Network prefix length of the shared IP, for example 24 for a 255.255.255.0 mask.
SHARED_IP_PREFIX=24

# The network card that carries THIS_IP and the shared IP. See: ip -br addr
INTERFACE=eth0

# XSOAR (Cortex XSOAR, the SOAR platform) server IP. It may call the API.
# Several IPs are allowed, separated by commas (for example XSOAR engines).
XSOAR_IP=198.51.100.20

# Firewall IP that downloads the EDL files (External Dynamic Lists).
# Use the address the firewall really connects from (often the management IP).
# For a firewall HA pair, list both, separated by commas.
FIREWALL_IP=198.51.100.1

# Days an IP stays in the active blocklist before the nightly job archives it.
ARCHIVE_AFTER_DAYS=30

# keepalived VRRP (Virtual Router Redundancy Protocol) password.
# Must be the same on both servers. 6 to 8 characters (keepalived uses only 8).
KEEPALIVED_PASSWORD=Chg3Me!x

# VRRP router ID, 1-255. Must be the same on both servers and unique on this network.
VRRP_ROUTER_ID=51

# yes = HTTPS with a self-signed certificate (default, use this in production).
# no  = plain HTTP. Only for a test lab.
USE_HTTPS=yes

# Maximum number of entries in each EDL. Your firewall limit is 50,000. 0 = no limit.
MAX_IPS=50000
MAX_DOMAINS=50000

# Who may connect with SSH. "any" or a comma-separated list of IPs/ranges.
# The other Furnace server is always allowed (it is needed for replication).
SSH_ALLOW_FROM=any

# Host firewall. ufw = configure ufw (default). none = do not touch the host firewall.
HOST_FIREWALL=ufw
