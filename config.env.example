# Furnace settings file, for a setup without questions (for example automation):
#     sudo furnace setup --config config.env
# Normally you do not need it: "sudo furnace setup" asks the same questions.
# Empty values are found automatically or get the default shown in the comment.
# All values below are FAKE examples from the documentation ranges.
# Never commit your real config.env.
#
# Follower: ROLE=follower is enough. The other settings come from the leader's
# bundle (furnace-peer-bundle.tar.gz). Settings you add must match the leader.

# leader = the preferred leader (keepalived priority 150).
# follower = the standby server (priority 100).
ROLE=leader

# This server's own IP address. Empty = the first IP of INTERFACE.
THIS_IP=192.0.2.11

# The other Furnace server's IP address.
PEER_IP=192.0.2.12

# The shared IP (VIP, virtual IP). The firewall and XSOAR always use this address.
SHARED_IP=192.0.2.10

# Network prefix length of the shared IP, for example 24 for a 255.255.255.0 mask.
SHARED_IP_PREFIX=24

# The network card that carries THIS_IP and the shared IP. See: ip -br addr
# Empty = the card of THIS_IP, or the card of the default route.
INTERFACE=eth0

# Who may call the API (XSOAR). "any" (default) = every address; every call still needs an API token.
# Or limit it to IPs and ranges, separated by commas (for example XSOAR engines).
XSOAR_IP=any

# Who may download the EDL files (External Dynamic Lists). "any" (default) = every address;
# every download still needs the EDL login (user and password).
# Or limit it: use the address the firewall really connects from (often the management IP).
# For a firewall HA pair, list both, separated by commas. Example: 198.51.100.1,198.51.100.2
FIREWALL_IP=any

# Days an IP stays in the active blocklist before the nightly job archives it.
ARCHIVE_AFTER_DAYS=30

# keepalived VRRP (Virtual Router Redundancy Protocol) password.
# Must be the same on both servers. 6 to 8 characters (keepalived uses only 8).
# Empty = setup creates a random one on the leader. The follower gets it from the bundle.
KEEPALIVED_PASSWORD=

# VRRP router ID, 1-255. Must be the same on both servers and unique on this network.
VRRP_ROUTER_ID=51

# yes = HTTPS with a self-signed certificate (default, use this in production).
# no  = plain HTTP. Only for a test lab.
USE_HTTPS=yes

# Maximum number of entries in each EDL. Your firewall limit is 50,000. 0 = no limit.
MAX_IPS=50000
MAX_DOMAINS=50000

# Who may connect with SSH. "any" or a comma-separated list of IPs/ranges.
# The other Furnace server is always allowed (it is needed for replication).
SSH_ALLOW_FROM=any

# Host firewall. ufw = configure ufw (default). none = do not touch the host firewall.
HOST_FIREWALL=ufw
