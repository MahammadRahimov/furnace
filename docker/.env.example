# Furnace settings for one host. Copy this file to .env next to docker-compose.yml and change it.
# All addresses below are FAKE examples from the documentation ranges: use your own.
# Check the settings without starting:  docker compose run --rm furnace check

# --- Change these four on every host ---------------------------------------------------------

# leader on one host, follower on the other.
FURNACE_ROLE=leader
# This host's IP.
FURNACE_THIS_IP=192.0.2.11
# The other host's IP.
FURNACE_PEER_IP=192.0.2.12
# The shared IP (VIP) the firewall and the API callers use. A free IP in the same network as the hosts.
FURNACE_SHARED_IP=192.0.2.10

# --- Optional (the same on both hosts); remove the # to change one ---------------------------

# Network prefix of the shared IP.
#FURNACE_SHARED_IP_PREFIX=24
# The host's network card. Empty = the card that has FURNACE_THIS_IP.
#FURNACE_INTERFACE=eth0
# Who may call the API ("any" or IPs and ranges, separated by commas). Every call still needs a token.
#FURNACE_API_ALLOW_FROM=any
# Who may download the lists ("any" or IPs and ranges). Always with the list login.
#FURNACE_LISTS_ALLOW_FROM=any
# keepalived group number, 1-255: the same on both hosts, different from other keepalived pairs on this network.
#FURNACE_VRRP_ROUTER_ID=51
# Days a blocked IP stays in the list (unless it is permanent). Domains and URLs never expire.
#FURNACE_ARCHIVE_AFTER_DAYS=90
# The most entries per list (0 = no limit). Many firewalls take at most 50,000 per list.
#FURNACE_MAX_IPS=50000
#FURNACE_MAX_DOMAINS=50000
#FURNACE_MAX_URLS=50000

# Time zone of the daily backup (01:30) and the nightly cleanup (02:30).
TZ=UTC
