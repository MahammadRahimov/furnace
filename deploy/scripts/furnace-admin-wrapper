#!/bin/bash
# Installed as /usr/local/bin/furnace-admin. Runs the real command as the furnace user.
set -euo pipefail
REAL=/opt/furnace/venv/bin/furnace-admin
if [ "$(id -un)" = "furnace" ]; then
    exec "$REAL" "$@"
fi
if [ "$(id -u)" -ne 0 ]; then
    echo "Run this with sudo: sudo furnace-admin $*" >&2
    exit 1
fi
exec runuser -u furnace -- env FURNACE_CONFIG=/etc/furnace/furnace.env "$REAL" "$@"
