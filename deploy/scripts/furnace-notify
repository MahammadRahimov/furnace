#!/bin/bash
# keepalived calls this script when the state of this server changes.
# Arguments: TYPE NAME STATE (STATE is MASTER, BACKUP, FAULT or STOP).
#
# It writes the role file that Furnace reads, and starts the nightly
# cleanup timer only on the server that owns the shared IP.
# In Docker there is no systemd: the container's process manager reads
# the role file and runs the cleanup on the leader only.
set -euo pipefail

STATE="${3:-}"
DIR=/run/furnace-state

install -d -m 0755 "$DIR"

set_role() {
    printf '%s\n' "$1" > "$DIR/role.tmp"
    chmod 0644 "$DIR/role.tmp"
    mv -f "$DIR/role.tmp" "$DIR/role"
}

with_systemd() { [ -d /run/systemd/system ]; }

say() {
    if [ -S /dev/log ]; then logger -t furnace "$*" || true; else echo "furnace: $*"; fi
}

case "$STATE" in
    MASTER)
        set_role leader
        if with_systemd; then systemctl start furnace-cleanup.timer || true; fi
        say "This server now owns the shared IP. It is the leader."
        ;;
    BACKUP|FAULT|STOP)
        set_role follower
        if with_systemd; then systemctl stop furnace-cleanup.timer || true; fi
        say "This server is now the standby (keepalived state: $STATE)."
        ;;
    *)
        say "furnace-notify: unknown state '$STATE', no change."
        ;;
esac
