#!/bin/bash
# keepalived health check. Exits 0 when nginx and the API answer /health.
# If it fails 3 times in a row, keepalived moves the shared IP to the other server.
set -euo pipefail

# shellcheck source=/dev/null
. /etc/furnace/install.env

# -k: the check talks to this same server over 127.0.0.1, so it does not verify the
# certificate. Both servers share one certificate: if the check failed on an expired
# certificate, both servers would give up the shared IP at the same moment and nobody
# would serve the lists. The expiry is reported by the daily certificate warnings.
exec curl -fsSk --max-time 3 -o /dev/null https://127.0.0.1/health
