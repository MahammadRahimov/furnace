#!/bin/sh
# furnace-python: start Python for Furnace, with the bundled libraries (Flask, gunicorn).
# Every Furnace service and command uses it, so they all run the same way on every Linux.
#
# It takes the system's python3 when that is 3.9 or newer. Otherwise the newest python3.X that
# is (for example python3.11 on systems whose python3 is older). FURNACE_PYTHON overrides it.
LIB=/usr/lib/furnace

ok() { "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; }

PY="${FURNACE_PYTHON:-}"
if [ -z "$PY" ]; then
    for candidate in python3 python3.14 python3.13 python3.12 python3.11 python3.10 python3.9; do
        if command -v "$candidate" >/dev/null 2>&1 && ok "$candidate"; then
            PY="$(command -v "$candidate")"
            break
        fi
    done
fi
if [ -z "$PY" ]; then
    echo "Furnace needs Python 3.9 or newer. Install it (for example the python3.11 package) and try again." >&2
    exit 1
fi

# Only Furnace and its bundled libraries: no user site-packages, no PYTHONPATH from outside.
PYTHONPATH="$LIB/vendor:$LIB"
PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH PYTHONDONTWRITEBYTECODE
exec "$PY" -s "$@"
