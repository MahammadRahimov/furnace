[Unit]
Description=Furnace nightly cleanup (move old IPs to the archive)

[Service]
Type=oneshot
User=furnace
Group=furnace
UMask=0027
EnvironmentFile=/etc/furnace/furnace.env
ExecStart=/usr/lib/furnace/bin/furnace-python -m furnace cleanup
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/furnace /var/lib/furnace-edl /var/lib/furnace-auth
