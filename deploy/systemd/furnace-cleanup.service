[Unit]
Description=Furnace nightly cleanup (move old IPs to the archive)

[Service]
Type=oneshot
User=furnace
Group=furnace
UMask=0027
EnvironmentFile=/etc/furnace/furnace.env
Environment=PYTHONPATH=/usr/lib/furnace PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m furnace cleanup
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/furnace /var/lib/furnace-edl /var/lib/furnace-auth
