[Unit]
Description=Load the newest Furnace snapshot from the leader (follower only)

[Service]
Type=oneshot
User=furnace
Group=furnace
UMask=0027
EnvironmentFile=/etc/furnace/furnace.env
Environment=PYTHONPATH=/usr/lib/furnace PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m furnace apply-replica /var/lib/furnace-incoming/snapshot.db
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/furnace /var/lib/furnace-edl
