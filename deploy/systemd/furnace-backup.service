[Unit]
Description=Furnace daily database backup

[Service]
Type=oneshot
User=furnace
Group=furnace
UMask=0027
EnvironmentFile=/etc/furnace/furnace.env
Environment=PYTHONPATH=/usr/lib/furnace PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m furnace backup
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/furnace
