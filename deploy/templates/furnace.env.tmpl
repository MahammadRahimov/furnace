# Furnace settings. Written by "furnace setup". Running setup again writes this file again.
# Secrets (API tokens) are NOT here. They are in /etc/furnace/tokens.env.
FURNACE_DATA_DIR=/var/lib/furnace
FURNACE_EDL_DIR=/var/lib/furnace-edl
FURNACE_ARCHIVE_DIR=/var/lib/furnace/archive
FURNACE_BACKUP_DIR=/var/lib/furnace/backups
FURNACE_TOKENS_FILE=/etc/furnace/tokens.env
FURNACE_ROLE_FILE=/run/furnace-state/role
FURNACE_ARCHIVE_AFTER_DAYS={{ARCHIVE_AFTER_DAYS}}
FURNACE_MAX_IPS={{MAX_IPS}}
FURNACE_MAX_DOMAINS={{MAX_DOMAINS}}
FURNACE_BACKUP_KEEP=14
FURNACE_CLEANUP_MAX_PERCENT=20
FURNACE_CLEANUP_MIN_SIZE=100
# Test ranges (192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24) stay refused in production.
FURNACE_ALLOW_TEST_RANGES=false
# The install self-test allows them for a few minutes by creating this root-owned file.
FURNACE_SELFTEST_FLAG=/run/furnace-state/selftest
