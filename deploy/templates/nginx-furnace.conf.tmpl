# Furnace - written by install.sh. A new install run writes this file again.
# Serves only the two EDL files (to the firewall), the API (to XSOAR) and /health.
# The database, the archive CSV and everything else are never served.

limit_req_zone $binary_remote_addr zone=furnace_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=furnace_edl:10m rate=2r/s;

server {
{{LISTEN}}
    server_name _;
    server_tokens off;
    limit_req_status 429;
{{TLS}}
    access_log /var/log/nginx/furnace-access.log;
    error_log /var/log/nginx/furnace-error.log warn;

    location = /edl/blocklist.txt {
{{FIREWALL_ALLOW}}
        allow 127.0.0.1;
        deny all;
        limit_req zone=furnace_edl burst=10 nodelay;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        alias /var/lib/furnace-edl/blocklist.txt;
    }

    location = /edl/domains.txt {
{{FIREWALL_ALLOW}}
        allow 127.0.0.1;
        deny all;
        limit_req zone=furnace_edl burst=10 nodelay;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        alias /var/lib/furnace-edl/domains.txt;
    }

    location /api/ {
{{XSOAR_ALLOW}}
        allow 127.0.0.1;
        deny all;
        limit_req zone=furnace_api burst=50 nodelay;
        client_max_body_size 20m;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location = /health {
        allow 127.0.0.1;
        allow {{THIS_IP}};
        allow {{PEER_IP}};
        deny all;
        proxy_pass http://127.0.0.1:8081/health;
    }

    location / {
        return 404;
    }
}
