#!/bin/bash
# furnace: the one command for the Furnace blocklist server.
# Run "furnace help" for the list of commands.
set -euo pipefail

LIB=/usr/lib/furnace
ETC=/etc/furnace
STATE_DIR=/run/furnace-state

py() { "$LIB/bin/furnace-python" "$@"; }
version() { py -c 'import furnace; print(furnace.__version__)'; }

need_root() {
    [ "$(id -u)" -eq 0 ] || { echo "Run this with sudo: sudo furnace $*" >&2; exit 1; }
}

need_setup() {
    [ -f "$ETC/furnace.env" ] || { echo "Furnace is installed but not set up yet. Run: sudo furnace setup" >&2; exit 1; }
}

usage() {
    cat <<EOF
Furnace $(version): blocklist server that publishes IP and domain lists (EDLs, threat feeds).

Usage: sudo furnace COMMAND [options]

Setup and health:
  setup                  Ask the setup questions, then configure and start everything.
  setup --config FILE    The same, with the answers from a settings file (no questions).
  setup --check          Show what setup would do. Change nothing.
  status                 Show the role, the services and the list counts.
  failover-test [--web]  Check that the other server takes over (run it on the leader).
  join-code              Leader: make a one-time code for the follower's setup (1 hour, used once).
  version                Show the version.

Data (details: sudo furnace COMMAND --help):
EOF
    py - <<'PY'
from furnace.admin import build_parser

parser = build_parser()
for action in parser._subparsers._group_actions:
    for choice in action._choices_actions:
        if not choice.help.startswith(("(replication", "(setup")):
            print(f"  {choice.dest:<23}{choice.help}")
PY
    echo
    echo "Uninstall: sudo apt remove furnace (keeps the data), sudo apt purge furnace (deletes all data)."
}

# The data commands run as the furnace user. A file to import that this user cannot
# read (for example in /root) is copied to a temporary folder first.
run_data_command() {
    need_root "$@"
    need_setup
    local args=("$@") tmp="" i
    if [[ "${args[0]}" == import-* ]]; then
        for ((i = 1; i < ${#args[@]}; i++)); do
            case "${args[i]}" in
                --report|--added-by|--reason|--date-format|--old-ips|--config) i=$((i + 1)) ;;
                -*) ;;
                *)
                    if [ -f "${args[i]}" ] && ! runuser -u furnace -- test -r "${args[i]}"; then
                        tmp="$(mktemp -d /tmp/furnace-import.XXXXXX)"
                        cp "${args[i]}" "$tmp/$(basename "${args[i]}")"
                        chown -R furnace:furnace "$tmp"
                        args[i]="$tmp/$(basename "${args[i]}")"
                    fi
                    break
                    ;;
            esac
        done
    fi
    local code=0
    runuser -u furnace -- env FURNACE_CONFIG="$ETC/furnace.env" FURNACE_ACTOR="${SUDO_USER:-root}" \
        "$LIB/bin/furnace-python" -m furnace "${args[@]}" || code=$?
    [ -n "$tmp" ] && rm -rf "$tmp"
    return "$code"
}

status() {
    need_root status
    need_setup
    # shellcheck source=/dev/null
    . "$ETC/install.env"
    local role problems=0 unit state want
    role="$(cat "$STATE_DIR/role" 2>/dev/null || echo unknown)"
    echo "Furnace $(version)"
    if ip -o -4 addr show dev "$INTERFACE" 2>/dev/null | grep -qF "inet ${SHARED_IP}/"; then
        echo "Role:     $role (this server owns the shared IP $SHARED_IP)"
    else
        echo "Role:     $role (the shared IP $SHARED_IP is on the other server, $PEER_IP)"
    fi
    echo "Server:   $THIS_IP on $INTERFACE, other server $PEER_IP"
    echo
    echo "Services:"
    for unit in furnace-api.service nginx.service keepalived.service furnace-replicate.timer \
                furnace-backup.timer furnace-apply-replica.path furnace-cleanup.timer; do
        # The path unit loads snapshots that came over SSH: it runs only with the SSH backup copy on.
        if [ "$unit" = furnace-apply-replica.path ] && [ "${REPLICATION_SSH_FALLBACK:-no}" != yes ]; then continue; fi
        state="$(systemctl is-active "$unit" 2>/dev/null || true)"
        want=active
        if [ "$unit" = "furnace-cleanup.timer" ]; then
            [ "$role" = "leader" ] || want=inactive   # the cleanup runs on the leader only
        fi
        if [ "$state" = "$want" ]; then
            printf '  %-28s %s\n' "$unit" "$state"
        else
            printf '  %-28s %s   <-- expected %s\n' "$unit" "$state" "$want"
            problems=1
        fi
    done
    echo
    # The leader writes the result of every replication (HTTPS, or SSH as the backup copy when it is on).
    local last="/var/lib/furnace/replica/last-result" when what age fallback="${REPLICATION_SSH_FALLBACK:-no}"
    if [ "$role" != "leader" ]; then
        echo "Replication: this server receives the snapshots from the leader"
    elif [ -f "$last" ]; then
        read -r when state what < "$last"
        age=$(( $(date +%s) - $(date -d "$when" +%s 2>/dev/null || echo 0) ))
        echo "Replication: $state $what ($age seconds ago)"
        if [ "$state" != "ok" ] || [ "$age" -gt 300 ]; then
            echo "             <-- the other server does not get the changes"
            echo "             Check: port 443 from here to the other server, nginx there, and the same certificate on both."
            [ "$fallback" = "yes" ] || echo "             (The SSH backup copy is off. It is optional: README, section 10.)"
            problems=1
        elif [[ "$what" == "over SSH"* ]]; then
            echo "             <-- HTTPS does not work: the copy went over the SSH backup. Fix HTTPS (the reason is above)."
            problems=1
        fi
    else
        echo "Replication: no result yet (it runs every 20 seconds)"
    fi
    if [ "$fallback" = "yes" ]; then
        echo "SSH backup: on (the copy uses SSH only when HTTPS does not work)"
    fi
    # A certificate made by setup before 0.8 on RHEL 8 has "Basic Constraints" twice. Not valid.
    local crt="$ETC/tls/furnace.crt"
    if [ -f "$crt" ] && openssl x509 -in "$crt" -noout -text 2>/dev/null \
            | grep -oE '^ +X509v3 [A-Za-z ]+:' | sort | uniq -d | grep -q .; then
        echo "Certificate: WARNING: $crt has an extension twice (made by an older setup on RHEL 8)."
        echo "             Some programs and firewalls reject it. Make a new one: README, section 6.10."
    fi
    echo
    run_data_command stats || problems=1
    if [ "$problems" -ne 0 ]; then
        echo
        echo "Something is not right. Look at: sudo journalctl -u furnace-api -u keepalived -u nginx --since -1h"
        return 1
    fi
}

# The leader makes a one-time code. The follower's setup uses it to fetch the certificate and the
# secrets over HTTPS (instead of a copied bundle file). See furnace/join.py.
join_code() {
    need_root join-code
    need_setup
    local ROLE="" THIS_IP="" PEER_IP="" code
    # shellcheck source=/dev/null
    . "$ETC/install.env"
    [ "$ROLE" = leader ] || { echo "Make the join code on the leader." >&2; exit 1; }
    code="$(tar -czf - -C "$ETC" tls/furnace.crt tls/furnace.key ssh/replica_key ssh/replica_key.pub setup.conf |
        py -m furnace.join make --bundle - --cert "$ETC/tls/furnace.crt" --leader-ip "$THIS_IP" \
            --dir /var/lib/furnace/join --owner furnace)"
    cat <<EOF
Join code for the follower (works once, for 60 minutes, only from $PEER_IP):

    $code

On the follower, run:  sudo furnace setup
and answer "follower". Setup asks for this code. (In a settings file: JOIN_CODE=$code)
The follower fetches the certificate and the secrets from this leader over HTTPS. A new code replaces this one.
EOF
}

case "${1:-help}" in
    help|-h|--help) usage ;;
    join-code) join_code ;;
    version|--version) version ;;
    setup) shift; need_root setup; exec "$LIB/setup.sh" "$@" ;;
    status) status ;;
    failover-test) shift; need_root failover-test; need_setup; exec "$LIB/bin/furnace-failover-test" "$@" ;;
    snapshot|apply-replica|send-replica|init-secrets) echo "'$1' is used by Furnace itself only." >&2; exit 2 ;;
    *) run_data_command "$@" ;;
esac
